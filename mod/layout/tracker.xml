<root>
	<styles>
		<include src="s2r://panorama/styles/deadlock_utils.vcss_c" />
	</styles>
	<!-- Tracker (70-tracker.js). Dois temas pela classe na raiz: o do jogo (versão normal) e DUTemaQol
	     (addon do QOL Lock, com as cores da janela do QOL). -->
	<Panel class="DUTracker">
		<Panel class="DUTrackerJanela">
			<Panel class="DUTrackerCab">
				<Panel class="DUTrackerCabIcone" />
				<Panel class="DUTrackerCabTextos">
					<Label class="DUTrackerTitulo" text="Tracker" />
					<Label id="DUTrackerStatus" class="DUTrackerStatus" html="true" text=" " />
				</Panel>
				<Panel class="DUTrackerCabAcoes">
					<Button id="DUTrackerAtualizar" class="DUTrackerBotao">
						<Label text="@tr.atualizar" />
					</Button>
					<Button id="DUTrackerFechar" class="DUTrackerBotao">
						<Label text="@tr.fechar" />
					</Button>
				</Panel>
			</Panel>
			<Panel class="DUTrackerCorpo">
				<Panel class="DUTrackerTimes">
					<Panel class="DUTrackerTimeCab DUTrackerTimeAmigo">
						<Label text="@tr.seuTime" />
					</Panel>
					<Panel id="DUTrackerAmigos" class="DUTrackerLista" />
					<Panel class="DUTrackerTimeCab DUTrackerTimeInimigo">
						<Label text="@tr.inimigos" />
					</Panel>
					<Panel id="DUTrackerInimigos" class="DUTrackerLista" />
				</Panel>
				<Panel id="DUTrackerDetalhe" class="DUTrackerDetalhe" />
			</Panel>
			<Label class="DUTrackerRodape" text="@tr.fonte" />
		</Panel>
	</Panel>
</root>
