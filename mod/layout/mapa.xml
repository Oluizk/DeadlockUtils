<root>
	<styles>
		<include src="s2r://panorama/styles/deadlock_utils.vcss_c" />
	</styles>
	<Panel class="DUMapa" hittest="false">
		<Panel class="DUMapaCaixa">
			<Label class="DUMapaTitulo" text="@mapa.titulo" />
			<Panel class="DUMapaLinha">
				<Label class="DUMapaRotulo" text="@mapa.partida" />
				<Label id="DUMapaRelogio" class="DUMapaValor" text="--:--" />
			</Panel>
			<Panel class="DUMapaLinha">
				<Label class="DUMapaRotulo" text="@mapa.ponte" />
				<Label id="DUMapaPonte" class="DUMapaValor" text="--:--" />
			</Panel>
			<Panel class="DUMapaLinha">
				<Label class="DUMapaRotulo" text="@mapa.midboss" />
				<Label id="DUMapaMidboss" class="DUMapaValor" html="true" text="-" />
			</Panel>
			<Panel class="DUMapaLinha DUMapaTamanho">
				<Label id="DUMapaTamRotulo" class="DUMapaRotulo" text="@mapa.tamanho" />
				<Button id="DUMapaMenor" class="DUMapaBotao"><Label text="-" /></Button>
				<Label id="DUMapaTamValor" class="DUMapaTamValor" text=" " />
				<Button id="DUMapaMaior" class="DUMapaBotao"><Label text="+" /></Button>
			</Panel>
			<Panel class="DUMapaLinha DUMapaTamanho">
				<Label id="DUMapaMiniRotulo" class="DUMapaRotulo" text="@mapa.pontosMini" />
				<Button id="DUMapaMiniPontos" class="DUAbaModo DUMapaMiniBotao"><Label text=" " /></Button>
			</Panel>
			<Label class="DUMapaSubtitulo" text="@mapa.mostrar" />
			<Panel id="DUMapaFiltros" class="DUMapaFiltros" />
			<Label class="DUMapaDica" html="true" text="@mapa.ajuda" />
			<Label id="DUMapaMaisOpcoes" class="DUMapaDica" html="true" text=" " />
		</Panel>
	</Panel>
</root>
